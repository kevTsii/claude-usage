<svg xmlns="http://www.w3.org/2000/svg" width="128" height="128" viewBox="0 0 128 128">
  <defs>
    <linearGradient id="fond" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#34364a"/>
      <stop offset="1" stop-color="#16171f"/>
    </linearGradient>
  </defs>
  <rect x="6" y="6" width="116" height="116" rx="28" fill="url(#fond)"/>
  <!-- Anneau extérieur : progression, comme dans la barre -->
  <g fill="none" stroke-width="11" transform="rotate(-90 64 64)">
    <circle cx="64" cy="64" r="42" stroke="#57e389" stroke-opacity="0.25"/>
    <circle cx="64" cy="64" r="42" stroke="#57e389" stroke-linecap="round" stroke-dasharray="171.5 264"/>
  </g>
  <!-- Logo Claude (étoile à 12 rayons) au centre, dimensionné pour laisser
       une marge régulière à l'intérieur de l'anneau (rayon utile 36,5) -->
  <g stroke="#d97757" stroke-width="5.5" stroke-linecap="round">
    <line x1="64" y1="64" x2="64.0" y2="35.0"/>
    <line x1="64" y1="64" x2="75.0" y2="44.9"/>
    <line x1="64" y1="64" x2="88.2" y2="50.0"/>
    <line x1="64" y1="64" x2="84.0" y2="64.0"/>
    <line x1="64" y1="64" x2="89.1" y2="78.5"/>
    <line x1="64" y1="64" x2="75.5" y2="83.9"/>
    <line x1="64" y1="64" x2="64.0" y2="91.0"/>
    <line x1="64" y1="64" x2="53.5" y2="82.2"/>
    <line x1="64" y1="64" x2="38.9" y2="78.5"/>
    <line x1="64" y1="64" x2="42.0" y2="64.0"/>
    <line x1="64" y1="64" x2="39.8" y2="50.0"/>
    <line x1="64" y1="64" x2="54.0" y2="46.7"/>
  </g>
</svg>
